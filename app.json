{
  "expo": {
    "name": "러닝그라운드",
    "slug": "runnigapp",
    "scheme": "runningground",
    "icon": "./assets/branding/icon.png",
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#11161B"
    },
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.minheee.runnigapp",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      },
      "buildNumber": "59"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#4338CA"
      },
      "versionCode": 49,
      "package": "com.minheee.runnigapp",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "로그인 정보를 안전하게 보관하기 위해 Face ID 생체 인증을 사용해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appVariant": "development",
      "router": {},
      "eas": {
        "projectId": "d57b0e4f-f084-4000-8ec7-188ee2561c52"
      }
    }
  }
}
