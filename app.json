{
  "expo": {
    "name": "runnigapp",
    "slug": "runnigapp",
    "scheme": "runnigapp",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.minheee.runnigapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow runnigapp to connect to local development servers on your network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "buildNumber": "10"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appVariant": "development",
      "router": {},
      "eas": {
        "projectId": "d57b0e4f-f084-4000-8ec7-188ee2561c52"
      }
    }
  }
}
