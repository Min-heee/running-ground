# Development example
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8081/api
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Expo app/build config
APP_VARIANT=development
IOS_BUNDLE_ID=com.anonymous.runnigapp.development
ANDROID_PACKAGE=com.anonymous.runnigapp.development
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
EAS_PROJECT_ID=
