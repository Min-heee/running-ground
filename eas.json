{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://willing-characters-connectors-darwin.trycloudflare.com/api",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "10000",
        "IOS_BUNDLE_ID": "com.minheee.runnigapp",
        "ANDROID_PACKAGE": "com.minheee.runnigapp",
        "EAS_PROJECT_ID": "d57b0e4f-f084-4000-8ec7-188ee2561c52"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.runnigapp.com/api",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "10000",
        "IOS_BUNDLE_ID": "com.minheee.runnigapp",
        "ANDROID_PACKAGE": "com.minheee.runnigapp",
        "EAS_PROJECT_ID": "d57b0e4f-f084-4000-8ec7-188ee2561c52"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6762328694"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6762328694"
      }
    }
  }
}
