{
  "name": "runnigapp-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./src/server.mjs",
    "dev": "node --watch ./src/server.mjs",
    "validate:env": "node ./scripts/validate-env.mjs",
    "validate:preview": "node ./scripts/validate-env.mjs --env-file .env.preview --env preview",
    "validate:production": "node ./scripts/validate-env.mjs --env-file .env.production --env production",
    "reset": "node ./src/reset-store.mjs",
    "backup": "node ./src/backup-store.mjs",
    "backups": "node ./src/list-backups.mjs",
    "restore": "node ./src/restore-store.mjs",
    "smoke": "node ./src/smoke.mjs",
    "test": "npm run test:repositories",
    "test:repositories": "npm run test:auth && npm run test:runs",
    "test:auth": "node ./src/repositories/authRepository.test.mjs && node ./src/repositories/postgresAuthRepository.test.mjs",
    "test:runs": "node ./src/repositories/runsRepository.test.mjs",
    "docker:build": "docker build -t runnigapp-backend .",
    "docker:up": "docker compose -f ./compose.yaml up --build -d",
    "docker:down": "docker compose -f ./compose.yaml down",
    "docker:logs": "docker compose -f ./compose.yaml logs -f",
    "docker:public:preview": "docker compose -p runnigapp-preview --env-file ./.env.preview -f ./compose.public.yaml up --build -d",
    "docker:public:preview:logs": "docker compose -p runnigapp-preview --env-file ./.env.preview -f ./compose.public.yaml logs -f",
    "docker:public:preview:down": "docker compose -p runnigapp-preview --env-file ./.env.preview -f ./compose.public.yaml down",
    "docker:public:production": "docker compose -p runnigapp-production --env-file ./.env.production -f ./compose.public.yaml up --build -d",
    "docker:public:production:logs": "docker compose -p runnigapp-production --env-file ./.env.production -f ./compose.public.yaml logs -f",
    "docker:public:production:down": "docker compose -p runnigapp-production --env-file ./.env.production -f ./compose.public.yaml down",
    "db:up": "docker compose -f ./compose.postgres.yaml up -d",
    "db:down": "docker compose -f ./compose.postgres.yaml down",
    "db:logs": "docker compose -f ./compose.postgres.yaml logs -f",
    "db:psql": "docker compose -f ./compose.postgres.yaml exec postgres psql -U runnigapp -d runnigapp_preview",
    "db:migrate:dry-run": "node ./db/migrate-json-to-postgres.mjs --dry-run",
    "db:migrate:sql": "node ./db/migrate-json-to-postgres.mjs --write-sql"
  },
  "engines": {
    "node": ">=20"
  }
}
