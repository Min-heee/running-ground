{
  "name": "runningground-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./src/server.mjs",
    "dev": "node --watch ./src/server.mjs",
    "validate:env": "node ./scripts/validate-env.mjs",
    "validate:preview": "node ./scripts/validate-env.mjs --backend-env-file .env.preview --env preview",
    "validate:production": "node ./scripts/validate-env.mjs --backend-env-file .env.production --env production",
    "reset": "node ./src/reset-store.mjs",
    "backup": "node ./src/backup-store.mjs",
    "backups": "node ./src/list-backups.mjs",
    "restore": "node ./src/restore-store.mjs",
    "smoke": "node ./src/smoke.mjs",
    "test": "npm run test:lib && npm run test:repositories && npm run test:bridges && npm run test:db && npm run test:routes && npm run test:contracts",
    "test:lib": "node ./src/lib/backendPureHelpers.test.mjs",
    "test:repositories": "npm run test:auth && npm run test:runs && npm run test:friends && npm run test:league && npm run test:admin && npm run test:market && npm run test:race",
    "test:auth": "node ./src/phoneVerification.test.mjs && node ./src/repositories/authRepository.test.mjs && node ./src/repositories/postgresAuthRepository.test.mjs",
    "test:runs": "node ./src/repositories/runsRepository.test.mjs && node ./src/repositories/postgresRunsRepository.test.mjs",
    "test:friends": "node ./src/repositories/friendsRepository.test.mjs && node ./src/repositories/postgresFriendsRepository.test.mjs",
    "test:league": "node ./src/repositories/leagueRepository.test.mjs && node ./src/repositories/postgresLeagueRepository.test.mjs",
    "test:admin": "node ./src/repositories/adminRepository.test.mjs",
    "test:market": "node ./src/repositories/marketRepository.test.mjs",
    "test:race": "node ./src/repositories/raceRepository.test.mjs",
    "test:bridges": "node ./src/bridges/sessionRunsBridge.test.mjs && node ./src/bridges/friendsLeagueBridge.test.mjs",
    "test:db": "node ./src/database/postgresDatabase.test.mjs",
    "test:routes": "node ./src/routes/index.test.mjs",
    "test:contracts": "node ./src/runningMatchContract.test.mjs",
    "docker:build": "docker build -t runningground-backend .",
    "docker:up": "docker compose -f ./compose.yaml up --build -d",
    "docker:down": "docker compose -f ./compose.yaml down",
    "docker:logs": "docker compose -f ./compose.yaml logs -f",
    "docker:public:preview": "docker compose -p runningground-preview --env-file ./.env.preview -f ./compose.public.yaml up --build -d",
    "docker:public:preview:logs": "docker compose -p runningground-preview --env-file ./.env.preview -f ./compose.public.yaml logs -f",
    "docker:public:preview:down": "docker compose -p runningground-preview --env-file ./.env.preview -f ./compose.public.yaml down",
    "docker:public:production": "docker compose -p runningground-production --env-file ./.env.production -f ./compose.public.yaml up --build -d",
    "docker:public:production:logs": "docker compose -p runningground-production --env-file ./.env.production -f ./compose.public.yaml logs -f",
    "docker:public:production:down": "docker compose -p runningground-production --env-file ./.env.production -f ./compose.public.yaml down",
    "db:up": "docker compose -f ./compose.postgres.yaml up -d",
    "db:down": "docker compose -f ./compose.postgres.yaml down",
    "db:logs": "docker compose -f ./compose.postgres.yaml logs -f",
    "db:psql": "docker compose -f ./compose.postgres.yaml exec postgres psql -U runningground -d runningground_preview",
    "db:check": "node ./scripts/check-postgres.mjs",
    "db:migrate:dry-run": "node ./db/migrate-json-to-postgres.mjs --dry-run",
    "db:migrate:sql": "node ./db/migrate-json-to-postgres.mjs --write-sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "solapi": "^6.0.1"
  }
}
