PUBLIC_DOMAIN=api.running-ground.com
ACME_EMAIL=ops@running-ground.com

POSTGRES_DB=runningground_production
POSTGRES_USER=runningground
POSTGRES_PASSWORD=change-this-production-postgres-password

BACKEND_APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8081
BACKEND_CORS_ORIGIN=https://api.running-ground.com
BACKEND_PUBLIC_BASE_URL=https://api.running-ground.com
BACKEND_STORE_DRIVER=postgres
BACKEND_STORE_FILE=/app/data/store.json
BACKEND_STORE_BACKUP_DIRECTORY=/app/data/backups
BACKEND_STORE_BACKUP_ON_SAVE=true
BACKEND_STORE_BACKUP_RETENTION=20
BACKEND_POSTGRES_DATABASE_URL=postgres://runningground:change-this-production-postgres-password@postgres:5432/runningground_production
BACKEND_POSTGRES_SSL=false
BACKEND_POSTGRES_POOL_MAX=10
BACKEND_POSTGRES_IDLE_TIMEOUT_MS=30000
BACKEND_POSTGRES_CONNECTION_TIMEOUT_MS=10000
BACKEND_POSTGRES_APPLICATION_NAME=runningground-backend-production
BACKEND_POSTGRES_ENABLE_SESSION_READS=false
BACKEND_POSTGRES_ENABLE_RUN_READS=false
BACKEND_POSTGRES_ENABLE_FRIEND_READS=false
BACKEND_POSTGRES_ENABLE_LEAGUE_READS=false
BACKEND_SESSION_TTL_HOURS=168
BACKEND_PHONE_VERIFICATION_PROVIDER=solapi
BACKEND_PHONE_VERIFICATION_CODE_TTL_MINUTES=5
BACKEND_PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
BACKEND_PHONE_VERIFICATION_MAX_ATTEMPTS=5
BACKEND_PHONE_VERIFICATION_VERIFIED_TTL_MINUTES=30
BACKEND_PHONE_VERIFICATION_EXPOSE_TEST_CODE=false
BACKEND_SOLAPI_API_KEY=change-this-production-solapi-key
BACKEND_SOLAPI_API_SECRET=change-this-production-solapi-secret
BACKEND_SOLAPI_SENDER=029302266
BACKEND_MAX_BODY_SIZE_KB=256
BACKEND_REQUEST_TIMEOUT_MS=30000
BACKEND_HEADERS_TIMEOUT_MS=10000
BACKEND_KEEP_ALIVE_TIMEOUT_MS=5000
BACKEND_MAX_REQUESTS_PER_SOCKET=1000
BACKEND_SHUTDOWN_TIMEOUT_MS=10000
BACKEND_ADMIN_TOKEN=change-this-production-admin-token
BACKEND_ENABLE_ADMIN_STATUS=true
BACKEND_ENABLE_RESET_ENDPOINT=false

# --- Rate limiting (2026-07 pre-launch batch) ---
# The public compose runs the api behind Caddy: TRUST_PROXY must stay true there
# or every user shares one rate-limit bucket (instant service-wide lockout).
BACKEND_TRUST_PROXY=true
# per-IP limits are loose on purpose (Korean carrier CGNAT puts many users behind
# one IP); the real billing guards are per-phone/day + global/day.
BACKEND_SMS_PER_IP_PER_HOUR=30
BACKEND_SMS_UNIQUE_PHONES_PER_IP_PER_DAY=20
BACKEND_SMS_PER_PHONE_PER_DAY=10
BACKEND_SMS_GLOBAL_PER_DAY=1000
BACKEND_LOGIN_PER_IP_PER_MINUTE=60
BACKEND_LOGIN_PER_ACCOUNT_PER_HOUR=20

# --- Match integrity / store (2026-07 pre-launch batch) ---
BACKEND_ALLOW_TEST_MATCHES=false
BACKEND_VANISHED_MATCH_TOMBSTONE_TTL_MS=21600000
# minimum ms between save-triggered store backups (0 = backup every changed save)
BACKEND_STORE_BACKUP_MIN_INTERVAL_MS=60000

# App-Review 로그인 우회 (둘 다 설정해야 활성화; 기본은 꺼짐).
# 심사관은 한국 SMS를 못 받으므로 이 번호는 SMS 발송 없이 고정 6자리 OTP로 로그인한다.
# 심사 전용 1회용 번호만 사용할 것 — 실제 유저 번호 금지.
# BACKEND_REVIEW_LOGIN_PHONE=01000000000
# BACKEND_REVIEW_LOGIN_OTP=000000
