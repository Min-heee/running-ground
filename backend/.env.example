# Development example
# For preview/production templates, use .env.preview.example or .env.production.example
BACKEND_APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8081
BACKEND_CORS_ORIGIN=*
BACKEND_PUBLIC_BASE_URL=http://localhost:8081
BACKEND_STORE_FILE=backend/data/store.json
BACKEND_STORE_BACKUP_DIRECTORY=backend/data/backups
BACKEND_STORE_BACKUP_ON_SAVE=false
BACKEND_STORE_BACKUP_RETENTION=10
BACKEND_SESSION_TTL_HOURS=168
BACKEND_MAX_BODY_SIZE_KB=256
BACKEND_TMAP_APP_KEY=
BACKEND_KAKAO_MOBILITY_REST_API_KEY=

# Optional admin helpers for desktop testing
BACKEND_ADMIN_TOKEN=change-me
BACKEND_ENABLE_ADMIN_STATUS=true
BACKEND_ENABLE_RESET_ENDPOINT=false
